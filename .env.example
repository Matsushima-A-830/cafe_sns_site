# Copy to .env.local and fill actual values. NEVER commit .env.local.
# [必須] は未設定だと起動時に lib/env.ts の Zod が落とす。[任意] は空のままでよい。

# --- [必須] Supabase (Local: pnpm db:start で表示されるキー) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- [必須] Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- [任意] Google Maps (S_MAP 実装まで不要) ---
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- [MVP未使用] AWS S3 (画像は Supabase Storage。S3 移行時に有効化 → pending-items A5) ---
AWS_S3_BUCKET=
AWS_S3_REGION=ap-northeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- メール送信 (Resend、保護者同意メール送信に使用) ---
# 未設定でも起動はできるが、submitGuardianConsent 等が EXTERNAL_SERVICE_ERROR を返す
RESEND_API_KEY=
# 独自ドメイン未認証の間は onboarding@resend.dev 固定。認証後は実ドメインに差し替える
RESEND_FROM_EMAIL=onboarding@resend.dev

# --- [任意] エラー通知 (Sentry) ---
SENTRY_DSN=
