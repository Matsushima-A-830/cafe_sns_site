# Copy to .env.local and fill actual values. NEVER commit .env.local.
# [必須] は未設定だと起動時に lib/env.ts の Zod が落とす。[任意] は空のままでよい。

# --- [必須] Supabase (Local: pnpm db:start で表示されるキー) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- [必須] Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- [任意] Google Maps (S_MAP 実装まで不要) ---
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- [任意] AWS S3 (画像配信。S3 採用を決めるまで不要 → pending-items A5) ---
AWS_S3_BUCKET=
AWS_S3_REGION=ap-northeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- [任意] メール送信 (Resend想定。未成年フロー実装まで不要) ---
RESEND_API_KEY=

# --- [任意] エラー通知 (Sentry) ---
SENTRY_DSN=
